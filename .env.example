# Runtime database connection (Turso)
TURSO_DATABASE_URL="libsql://YOUR_DATABASE-YOUR_ORG.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN="YOUR_TURSO_AUTH_TOKEN"

# NextAuth
AUTH_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
AUTH_GOOGLE_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
AUTH_GOOGLE_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

# Email OTP delivery
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM="Presently <no-reply@your-verified-domain.com>"

# Prisma CLI datasource URL; use the value appropriate for your local/remote workflow.
DATABASE_URL="file:./dev.db"
